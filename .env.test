APP_ENV=test
APP_DEBUG=1
APP_SECRET=test_secret

DB_NAME=ecom_test

DATABASE_URL="postgresql://%env(resolve:DB_USER)%:%env(resolve:DB_PASSWORD)%@%env(resolve:DB_HOST)%:%env(resolve:DB_PORT)%/%env(resolve:DB_NAME)%?serverVersion=16&charset=utf8&options=--search_path=public"

MESSENGER_TRANSPORT_DSN="in-memory://default"

ELASTICSEARCH_HOST="https://localhost:9200"
ELASTICSEARCH_VERIFY_SSL=0

MERCURE_URL=http://127.0.0.1/.well-known/mercure
MERCURE_PUBLIC_URL=http://127.0.0.1/.well-known/mercure
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!

MAILER_DSN=null://localhost
