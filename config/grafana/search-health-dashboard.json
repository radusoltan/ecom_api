{
  "dashboard": {
    "id": null,
    "uid": "search-health",
    "title": "Search Health - E-Commerce Platform",
    "tags": ["search", "elasticsearch", "catalog", "multi-tenant"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "type": "graph",
        "title": "Cache Hit Ratio Over Time",
        "targets": [
          {
            "expr": "ecom_catalog_cache_hit_ratio{job=\"ecommerce-backend\"}",
            "legendFormat": "{{tenant}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percentunit",
            "label": "Hit Ratio",
            "min": 0,
            "max": 1
          }
        ],
        "legend": {
          "show": true,
          "alignAsTable": true,
          "values": true,
          "current": true,
          "avg": true,
          "min": true
        },
        "alert": {
          "name": "Low Cache Hit Ratio",
          "conditions": [
            {
              "evaluator": {
                "params": [0.7],
                "type": "lt"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "5m",
          "frequency": "1m",
          "message": "Cache hit ratio is below 70% - consider investigating cache configuration",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 2,
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "type": "stat",
        "title": "Current Cache Hit Ratio",
        "targets": [
          {
            "expr": "ecom_catalog_cache_hit_ratio{job=\"ecommerce-backend\"}",
            "legendFormat": "{{tenant}}",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 0.7,
                  "color": "yellow"
                },
                {
                  "value": 0.9,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 24,
          "h": 8
        },
        "type": "table",
        "title": "Cache Performance by Tenant",
        "targets": [
          {
            "expr": "topk(10, ecom_catalog_cache_hit_ratio{job=\"ecommerce-backend\"})",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true,
                "job": true,
                "instance": true
              },
              "renameByName": {
                "tenant": "Tenant ID",
                "Value": "Cache Hit Ratio"
              }
            }
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "Cache Hit Ratio",
              "desc": false
            }
          ]
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "color-background"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 0.7,
                  "color": "yellow"
                },
                {
                  "value": 0.9,
                  "color": "green"
                }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Cache Hit Ratio"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percentunit"
                }
              ]
            }
          ]
        }
      },
      {
        "id": 4,
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 24,
          "h": 1
        },
        "type": "row",
        "title": "API Performance Metrics",
        "collapsed": false
      },
      {
        "id": 5,
        "gridPos": {
          "x": 0,
          "y": 17,
          "w": 12,
          "h": 8
        },
        "type": "graph",
        "title": "Product API Request Rate",
        "targets": [
          {
            "expr": "sum by(tenant, route) (rate(ecom_catalog_api_latency_seconds_count{route=~\".*product.*\"}[5m]))",
            "legendFormat": "{{tenant}} - {{route}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          }
        ]
      },
      {
        "id": 6,
        "gridPos": {
          "x": 12,
          "y": 17,
          "w": 12,
          "h": 8
        },
        "type": "graph",
        "title": "Category API Request Rate",
        "targets": [
          {
            "expr": "sum by(tenant, route) (rate(ecom_catalog_api_latency_seconds_count{route=~\".*category.*\"}[5m]))",
            "legendFormat": "{{tenant}} - {{route}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          }
        ]
      },
      {
        "id": 7,
        "gridPos": {
          "x": 0,
          "y": 25,
          "w": 24,
          "h": 1
        },
        "type": "row",
        "title": "Future: Elasticsearch Metrics (when implemented)",
        "collapsed": true
      }
    ],
    "templating": {
      "list": [
        {
          "name": "tenant",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(ecom_catalog_cache_hit_ratio, tenant)",
          "multi": true,
          "includeAll": true,
          "refresh": 1
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "ALERTS{alertname=\"LowCacheHit\", alertstate=\"firing\"}",
          "iconColor": "rgba(255, 96, 96, 1)",
          "name": "Cache Alerts",
          "titleFormat": "Cache Alert"
        }
      ]
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    }
  }
}
