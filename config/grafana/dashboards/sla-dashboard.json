{
  "uid": "ecom-sla-dashboard",
  "title": "SLA Dashboard",
  "tags": ["ecommerce", "sla", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["1m", "5m", "15m"]
  },
  "templating": {
    "list": [
      {
        "name": "slo_window",
        "label": "SLO Window",
        "type": "custom",
        "query": "7d,14d,30d",
        "current": { "selected": true, "text": "7d", "value": "7d" },
        "multi": false,
        "includeAll": false
      },
      {
        "name": "tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(ecom_catalog_api_latency_seconds_count, tenant)", "refId": "tenant" },
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "SLO Overview",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "description": "API availability over SLO window (target: 99.9%)",
      "gridPos": { "x": 0, "y": 1, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "avg_over_time(up{job=\"ecommerce-api\"}[$slo_window]) * 100",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 99, "color": "orange" },
              { "value": 99.5, "color": "yellow" },
              { "value": 99.9, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Error Budget Remaining",
      "description": "Remaining error budget for the SLO window (SLO: 99.9% = 0.1% budget)",
      "gridPos": { "x": 5, "y": 1, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "clamp_min(1 - ((1 - avg_over_time(up{job=\"ecommerce-api\"}[$slo_window])) / 0.001), 0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.1, "color": "orange" },
              { "value": 0.3, "color": "yellow" },
              { "value": 0.5, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "API Latency p95",
      "description": "Current p95 latency vs 200ms SLO",
      "gridPos": { "x": 10, "y": 1, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ecom_catalog_api_latency_seconds_bucket{tenant=~\"$tenant\"}[5m])) by (le))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.15, "color": "yellow" },
              { "value": 0.2, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Cache Hit vs SLO",
      "description": "Cache hit ratio vs 90% target",
      "gridPos": { "x": 15, "y": 1, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "avg(ecom_catalog_cache_hit_ratio{tenant=~\"$tenant\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.7, "color": "yellow" },
              { "value": 0.9, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Error Rate vs SLO",
      "description": "Current error rate vs 1% SLO target",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ecom_catalog_api_latency_seconds_count{tenant=~\"$tenant\", status=~\"5..\"}[5m])) / sum(rate(ecom_catalog_api_latency_seconds_count{tenant=~\"$tenant\"}[5m])) * 100 or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.5, "color": "yellow" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "type": "row",
      "title": "SLI Tracking",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 },
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "API Latency p95 Over Time",
      "description": "p95 latency with 200ms SLO threshold line",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ecom_catalog_api_latency_seconds_bucket{tenant=~\"$tenant\"}[5m])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "axisLabel": "Latency",
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "transparent" },
              { "value": 0.2, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Error Rate Over Time",
      "description": "5xx error rate with 1% SLO threshold line",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ecom_catalog_api_latency_seconds_count{tenant=~\"$tenant\", status=~\"5..\"}[5m])) / sum(rate(ecom_catalog_api_latency_seconds_count{tenant=~\"$tenant\"}[5m])) * 100 or vector(0)",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "axisLabel": "Error %",
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "transparent" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      }
    },
    {
      "type": "row",
      "title": "Error Budget Burn Rate",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 },
      "id": 102,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Error Budget Burn Rate (Multi-Window)",
      "description": "Rate of error budget consumption across 1h, 6h, and 24h windows. Burn rate >1 means consuming budget faster than allowed.",
      "gridPos": { "x": 0, "y": 16, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(1 - avg_over_time(up{job=\"ecommerce-api\"}[1h])) / 0.001",
          "legendFormat": "1h burn rate",
          "refId": "A"
        },
        {
          "expr": "(1 - avg_over_time(up{job=\"ecommerce-api\"}[6h])) / 0.001",
          "legendFormat": "6h burn rate",
          "refId": "B"
        },
        {
          "expr": "(1 - avg_over_time(up{job=\"ecommerce-api\"}[24h])) / 0.001",
          "legendFormat": "24h burn rate",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false,
            "axisLabel": "Burn Rate (x budget)",
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Budget Burn (1h)",
      "gridPos": { "x": 16, "y": 16, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(1 - avg_over_time(up{job=\"ecommerce-api\"}[1h])) / 0.001",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "orange" },
              { "value": 3, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Budget Burn (6h)",
      "gridPos": { "x": 19, "y": 16, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(1 - avg_over_time(up{job=\"ecommerce-api\"}[6h])) / 0.001",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "orange" },
              { "value": 3, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Budget Burn (24h)",
      "gridPos": { "x": 22, "y": 16, "w": 2, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(1 - avg_over_time(up{job=\"ecommerce-api\"}[24h])) / 0.001",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "orange" },
              { "value": 3, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "type": "row",
      "title": "Detailed SLIs",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 1 },
      "id": 103,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Cache Hit Rate vs SLO (90%)",
      "gridPos": { "x": 0, "y": 25, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "avg(ecom_catalog_cache_hit_ratio{tenant=~\"$tenant\"}) * 100",
          "legendFormat": "Cache Hit %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "transparent" },
              { "value": 90, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min", "lastNotNull"] }
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Thumbnail Generation p95 vs SLO (5s)",
      "gridPos": { "x": 8, "y": 25, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ecom_thumbnail_generation_seconds_bucket{tenant=~\"$tenant\"}[5m])) by (le))",
          "legendFormat": "p95 Thumbnail Gen",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "transparent" },
              { "value": 5, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Request Success Rate",
      "description": "Percentage of non-5xx requests",
      "gridPos": { "x": 16, "y": 25, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(1 - (sum(rate(ecom_catalog_api_latency_seconds_count{tenant=~\"$tenant\", status=~\"5..\"}[5m])) / sum(rate(ecom_catalog_api_latency_seconds_count{tenant=~\"$tenant\"}[5m])))) * 100 or vector(100)",
          "legendFormat": "Success Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 95,
          "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "transparent" },
              { "value": 99, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min", "lastNotNull"] }
      }
    },
    {
      "type": "row",
      "title": "SLO Compliance Report",
      "gridPos": { "x": 0, "y": 33, "w": 24, "h": 1 },
      "id": 104,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 40,
      "type": "table",
      "title": "SLO Compliance Summary",
      "description": "Overview of all SLOs, their targets, current values, and compliance status",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "vector(99.9)",
          "legendFormat": "API Availability",
          "refId": "target_availability",
          "format": "table",
          "instant": true
        },
        {
          "expr": "avg_over_time(up{job=\"ecommerce-api\"}[$slo_window]) * 100",
          "legendFormat": "API Availability",
          "refId": "current_availability",
          "format": "table",
          "instant": true
        },
        {
          "expr": "vector(200)",
          "legendFormat": "API Latency p95 (ms)",
          "refId": "target_latency",
          "format": "table",
          "instant": true
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ecom_catalog_api_latency_seconds_bucket{tenant=~\"$tenant\"}[$slo_window])) by (le)) * 1000 or vector(0)",
          "legendFormat": "API Latency p95 (ms)",
          "refId": "current_latency",
          "format": "table",
          "instant": true
        },
        {
          "expr": "vector(1)",
          "legendFormat": "Error Rate (%)",
          "refId": "target_error",
          "format": "table",
          "instant": true
        },
        {
          "expr": "(sum(rate(ecom_catalog_api_latency_seconds_count{tenant=~\"$tenant\", status=~\"5..\"}[$slo_window])) / sum(rate(ecom_catalog_api_latency_seconds_count{tenant=~\"$tenant\"}[$slo_window]))) * 100 or vector(0)",
          "legendFormat": "Error Rate (%)",
          "refId": "current_error",
          "format": "table",
          "instant": true
        },
        {
          "expr": "vector(90)",
          "legendFormat": "Cache Hit Rate (%)",
          "refId": "target_cache",
          "format": "table",
          "instant": true
        },
        {
          "expr": "avg(avg_over_time(ecom_catalog_cache_hit_ratio{tenant=~\"$tenant\"}[$slo_window])) * 100 or vector(0)",
          "legendFormat": "Cache Hit Rate (%)",
          "refId": "current_cache",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "filterable": false, "align": "center" }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      },
      "transformations": []
    }
  ]
}
