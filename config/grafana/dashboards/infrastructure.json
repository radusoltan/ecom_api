{
  "uid": "ecom-infrastructure",
  "title": "Infrastructure",
  "tags": ["ecommerce", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
