    {
      "id": 30,
      "type": "stat",
      "title": "ES Cluster Health",
      "description": "1=green, 2=yellow, 3=red",
      "gridPos": { "x": 0, "y": 21, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "elasticsearch_cluster_health_status{color=\"green\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "GREEN", "color": "green" }, "0": { "text": "NOT GREEN", "color": "red" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "green" }
