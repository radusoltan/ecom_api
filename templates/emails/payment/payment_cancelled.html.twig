{% extends 'emails/base.html.twig' %}

{% block email_title %}{{ 'emails.payment.cancelled.title'|trans }}{% endblock %}

{% block header_icon %}⚠️{% endblock %}

{% block header_title %}{{ 'emails.payment.cancelled.header'|trans }}{% endblock %}

{% block content %}
    <style>
        .email-header {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important;
        }
        .info-box {
            border-left-color: #f59e0b !important;
        }
        .info-box h3 {
            color: #f59e0b !important;
        }
        .button {
            background-color: #f59e0b !important;
        }
        .button:hover {
            background-color: #d97706 !important;
        }
        .warning-box {
            background-color: #fffbeb;
            border-left: 4px solid #f59e0b;
            padding: 15px;
            margin: 20px 0;
            border-radius: 4px;
        }
        .warning-box p {
            color: #92400e;
            margin: 5px 0;
        }
    </style>

    <p>{{ 'emails.payment.cancelled.greeting'|trans({'%customer_name%': customer_name}) }}</p>

    <p>{{ 'emails.payment.cancelled.notification'|trans }}</p>

    <div class="info-box">
        <h3>{{ 'emails.payment.cancellation_details'|trans }}</h3>
        <div class="info-row">
            <span class="info-label">{{ 'emails.payment.payment_id'|trans }}:</span>
            <span class="info-value"><strong>{{ payment_id }}</strong></span>
        </div>
        <div class="info-row">
            <span class="info-label">{{ 'emails.payment.amount'|trans }}:</span>
            <span class="info-value"><strong>{{ amount }} {{ currency }}</strong></span>
        </div>
        <div class="info-row">
            <span class="info-label">{{ 'emails.payment.cancelled_date'|trans }}:</span>
            <span class="info-value">{{ date|date('d/m/Y H:i') }}</span>
        </div>
        {% if order_id is defined %}
            <div class="info-row">
                <span class="info-label">{{ 'emails.payment.order_id'|trans }}:</span>
                <span class="info-value">{{ order_id }}</span>
            </div>
        {% endif %}
        {% if reason is defined and reason is not empty %}
            <div class="info-row">
                <span class="info-label">{{ 'emails.payment.cancellation_reason'|trans }}:</span>
                <span class="info-value">{{ reason }}</span>
            </div>
        {% endif %}
    </div>

    <div class="warning-box">
        <h4 style="color: #f59e0b; margin-bottom: 10px;">{{ 'emails.payment.cancelled.what_this_means'|trans }}</h4>
        <p>{{ 'emails.payment.cancelled.no_charge_info'|trans }}</p>
        <p>{{ 'emails.payment.cancelled.authorization_voided'|trans }}</p>
    </div>

    <div class="info-box" style="border-left-color: #3b82f6;">
        <h3 style="color: #3b82f6;">{{ 'emails.payment.cancelled.next_steps'|trans }}</h3>
        <ul style="margin-left: 20px; margin-top: 10px;">
            <li>{{ 'emails.payment.cancelled.order_not_processed'|trans }}</li>
            <li>{{ 'emails.payment.cancelled.funds_released'|trans }}</li>
            <li>{{ 'emails.payment.cancelled.can_place_new_order'|trans }}</li>
        </ul>
    </div>

    {% if restartOrderUrl is defined %}
        <p style="text-align: center;">
            <a href="{{ restartOrderUrl }}" class="button">{{ 'emails.payment.cancelled.place_new_order'|trans }}</a>
        </p>
    {% endif %}

    <div class="divider"></div>

    <p>{{ 'emails.payment.cancelled.apology'|trans }}</p>
    <p>{{ 'emails.payment.cancelled.questions'|trans }}</p>
{% endblock %}
